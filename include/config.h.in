#pragma once

#include <string>

#include "version.hpp"

#define APPLICATION_NAME "NSClient++"

#if defined(_M_IX86)
#define SZARCH "w32"
#elif defined(_M_X64)
#define SZARCH "x64"
#elif defined(_M_IA64)
#define SZARCH "ia64"
#else
#define SZARCH "unknown"
#endif

#define DEFAULT_SERVICE_NAME "@CONFIG_DEFAULT_SERVICE_NAME@"
#define DEFAULT_SERVICE_DESC "@CONFIG_DEFAULT_SERVICE_DESC@"
#define DEFAULT_SERVICE_DEPS "@CONFIG_DEFAULT_SERVICE_DEPS@"

// displayed name and version
#define SERVICE_NAME APPLICATION_NAME " " CURRENT_SERVICE_VERSION " " SZARCH
#define CURRENT_SERVICE_VERSION STRPRODUCTVER " " STRPRODUCTDATE

#define CRASH_ARCHIVE_FOLDER_KEY "crash-folder"
#define CACHE_FOLDER_KEY "cache-folder"
#define FLEET_FOLDER_KEY "fleet-folder"
#define CACHE_FOLDER "${cache-folder}"

#define CRASH_SUBMIT_URL "@CONFIG_CRASH_SUBMIT_URL@"
#define CRASH_ARCHIVE_FOLDER "@CONFIG_CRASH_ARCHIVE_FOLDER@"

#define DEFAULT_CONF_LOCATION "@CONFIG_DEFAULT_CONF_LOCATION@"
#define DEFAULT_CONF_OLD_LOCATION "@CONFIG_DEFAULT_CONF_OLD_LOCATION@"
#define DEFAULT_CONF_REG_LOCATION "@CONFIG_DEFAULT_CONF_REG_LOCATION@"
#define BOOT_CONF_LOCATION "@CONFIG_BOOT_CONF_LOCATION@"
#define DEFAULT_CONF_INI_BASE "@CONFIG_DEFAULT_CONF_INI_BASE@"
#define DEFAULT_CONF_INI_LOCATION "@CONFIG_DEFAULT_CONF_INI_LOCATION@"
#define DEFAULT_LOG_LOCATION "@CONFIG_DEFAULT_LOG_LOCATION@"
#define DEFAULT_CACHE_PATH "@CONFIG_DEFAULT_CACHE_PATH@"
#define MODULE_FOLDER "@CONFIG_MODULE_FOLDER@"
#define WEB_FOLDER "@CONFIG_WEB_FOLDER@"
#define SCRIPTS_FOLDER "@CONFIG_SCRIPTS_FOLDER@"
#define CERT_FOLDER "@CONFIG_CERT_FOLDER@"
// The two candidate homes for the shipped NRPE DH parameters. They differ on
// Windows, where the installer leaves them beside the executable while
// ${certificate-path} moves to %ProgramData% under the modern layout; on unix
// both name the package directory. The ${nrpe-dh} token resolves to whichever
// one actually contains them - see nsclient::core::path_manager.
#define MODERN_NRPE_DH_FOLDER "@CONFIG_MODERN_NRPE_DH_FOLDER@"
#define LEGACY_NRPE_DH_FOLDER "@CONFIG_LEGACY_NRPE_DH_FOLDER@"
// Trusted CA bundle used whenever a check does not name its own. On Windows the
// service exports the ROOT store to this file at boot; on unix it is the system
// bundle, detected at configure time because its location differs per
// distribution (see CONFIG_CA_PATH in CMakeLists.txt).
#define CA_PATH "@CONFIG_CA_PATH@"
#define LOG_FOLDER "@CONFIG_LOG_FOLDER@"
// Fleet enrollment manifest and the directory the fleet sync writes its
// rendered configuration, scripts and bundle cache into. Both are written after
// install and mutated at runtime, so on unix they live under the state
// directory rather than the read-only package directory.
//
// FLEET_FOLDER is only the *default* for the ${fleet-folder} path token
// (FLEET_FOLDER_KEY). Everything that needs the directory resolves the token,
// so it can be relocated from boot.ini's [paths] or --path-override like any
// other folder. The one exception is the MSI custom action, which runs without
// the path resolver and therefore expands this macro itself.
#define DEFAULT_FLEET_STATE_LOCATION "@CONFIG_FLEET_STATE_LOCATION@"
#define FLEET_FOLDER "@CONFIG_FLEET_FOLDER@"
#ifndef WIN32
#define UNIX_SHARED_PATH_FOLDER "@UNIX_SHARED_PATH_FOLDER@"
#define UNIX_DATA_PATH_FOLDER "@UNIX_DATA_PATH_FOLDER@"
// Config root for this build (NSCP_SYSCONFDIR): tracks CMAKE_INSTALL_PREFIX,
// e.g. /etc for --prefix=/usr, /usr/local/etc for --prefix=/usr/local. Backs
// the ${etc} path token. NOT the system CA location - see ca-path.
#define ETC_FOLDER "@CONFIG_ETC_FOLDER@"
#endif

#define NASTY_METACHARS "|`&><'\"\\[]{}" /* This may need to be modified for windows directory seperator */
/* Stricter set, enforced ONLY when a command degrades to the shell fallback
 * (/bin/sh -c on Unix, a raw CreateProcess command line on Windows) in
 * CheckExternalScripts. The shared NASTY_METACHARS above deliberately permits
 * %, (, ), $ so internal check syntax (e.g. "top-syntax=%(status): %(list)"
 * / "filter=...") keeps working over NRPE/check_nt - those checks never touch a
 * shell. Once a string is handed to a shell, however, those characters are
 * dangerous, so block them on that path only. `%` and `^` are included for
 * cmd.exe: `%VAR%` expands environment variables and `^` is cmd's escape
 * character, so an argument reaching a .bat via cmd could otherwise smuggle
 * environment contents or escape sequences into the command line. */
#define SHELL_METACHARS "|`&><'\"\\[]{}$;()*?~!\n\r%^"

#define MAIN_MODULES_SECTION "/modules"
#define NS_HKEY_ROOT HKEY_LOCAL_MACHINE
#define NS_REG_ROOT L"SOFTWARE\\NSClient++"
