<Include>
	<!-- CONFIGURE APPLICATION INFORMATION -->
	<Property Id="ARPCOMMENTS">NSClient++ is a monitoring Agent for amongst other systems Nagios</Property>
	<Property Id="ARPCONTACT">michael@medin.name</Property>
	<Property Id="ARPHELPLINK">https://nsclient.org</Property>
	<Property Id="ARPURLINFOABOUT">https://nsclient.org</Property>
	<Property Id="ARPURLUPDATEINFO">https://nsclient.org</Property>
	<Property Id="ARPHELPTELEPHONE">https://nsclient.org</Property>
	<!-- Must name an Icon row from Product.wxs; see the note there for why
	     this is a .ico and not the agent executable. -->
	<Property Id="ARPPRODUCTICON">nsclient.ico</Property>

	<!-- DEFAULT MONITORING TOOL -->
	<Property Id="MONITORING_TOOL">GENERIC</Property>

	<!-- MANAGEMENT SERVER (ManagementServerDlg)
	     Where this agent's configuration comes from: NONE (it is configured on
	     this machine, the default and what every installer before this one
	     did), FLEET (an NSClient fleet server manages it) or WEB (an
	     nsclient.ini served over HTTP(S)).

	     On a silent install it is derived rather than given: FLEET_SERVER means
	     FLEET, a http(s) CONFIGURATION_TYPE means WEB - so the command lines
	     that already do either keep working unchanged.

	     Secure so a value picked in the UI, or passed on the command line,
	     survives the handover to the elevated half of the install. -->
	<Property Id="MANAGEMENT_SERVER" Secure="yes">NONE</Property>
	<!-- The WEB url, as typed. ApplyManagement is what turns it into
	     CONFIGURATION_TYPE once it has been checked. -->
	<Property Id="MANAGEMENT_URL" Secure="yes" />
	<!-- The one opt-out of verifying who is on the other end, for both managed
	     modes: a plain http url, or a certificate that cannot be verified.
	     Maps to FLEET_INSECURE / TLS_VERIFY_MODE=none. -->
	<Property Id="MANAGEMENT_INSECURE" Secure="yes" />
	<!-- Internal to whichever sequence the two actions run in, never given on a
	     command line: MGMT_DERIVED says the mode was worked out rather than
	     asked for, MGMT_ENROLLED that this host already carries an enrollment,
	     and MGMT_ERROR carries what ApplyManagement rejected to
	     ManagementErrorDlg. -->
	<Property Id="MGMT_DERIVED" />
	<Property Id="MGMT_ENROLLED" />
	<Property Id="MGMT_ERROR" />
	
	<!-- CONFIGURE THE INSTALLER -->
	<Property Id="ALLOW_CONFIGURATION">1</Property>
	<WixVariable Id="WixUIBannerBmp" Value="Bitmaps\bannrbmp.bmp" />
	<WixVariable Id="WixUIDialogBmp" Value="Bitmaps\dlgbmp.bmp" />

	<!-- CONFIGURE THE PROGRAM -->
	<Property Id="HELP_LINK">https://nsclient.org/nscp/</Property>
	<Property Id="SERVICE_NAME">$(var.App.ServiceName)</Property>
	<Property Id="APP_TITLE">$(var.App.Title) Monitoring Agent</Property>
  
	<!-- FLEET ONBOARDING
	     Declared (rather than just read by the custom actions) to mark them
	     Secure, so they survive a managed/elevated install, and to hide the
	     bootstrap token: it is a one-time credential that exchanges for this
	     host's client certificate, so it must not end up in the MSI log -
	     neither as the property itself nor as the CustomActionData of the
	     deferred action (that data lives in a property named after the
	     action). -->
	<Property Id="FLEET_SERVER" Secure="yes" />
	<Property Id="FLEET_TOKEN" Secure="yes" Hidden="yes" />
	<Property Id="FLEET_HOSTNAME" Secure="yes" />
	<Property Id="FLEET_CA" Secure="yes" />
	<Property Id="FLEET_VERIFY_MODE" Secure="yes" />
	<Property Id="FLEET_INSECURE" Secure="yes" />
	<!-- Hidden for the same reason as the token: it opens every sealed bundle. -->
	<Property Id="FLEET_BUNDLE_KEY" Secure="yes" Hidden="yes" />
	<Property Id="FLEET_REQUIRE_ENCRYPTED_BUNDLES" Secure="yes" />
	<Property Id="ExecEnrollFleet" Hidden="yes" />

	<!-- The settings transport the installer uses when CONFIGURATION_TYPE (or
	     IMPORT_CONFIG) is a url. Declared to mark them Secure: the management
	     server page writes TLS_CA in the UI sequence, and a public property set
	     there only reaches the elevated half of a managed install when it is
	     listed in SecureCustomProperties. -->
	<Property Id="TLS_VERSION" Secure="yes" />
	<Property Id="TLS_VERIFY_MODE" Secure="yes" />
	<Property Id="TLS_CA" Secure="yes" />

	<!-- OPERATOR-SUPPLIED TLS MATERIAL (GitHub #568)
	     Paths to PEM files on the installing machine, installed into
	     ${certificate-path} as certificate.pem / certificate_key.pem / ca.pem
	     so the servers pick them up under their default settings and the
	     service never generates its self-signed fallback. Declared to mark
	     them Secure so they survive a managed/elevated install; they are
	     paths, not secrets, so they are not hidden. -->
	<Property Id="CERTIFICATE" Secure="yes" />
	<Property Id="CERTIFICATE_KEY" Secure="yes" />
	<Property Id="CERTIFICATE_CA" Secure="yes" />

	<!-- On-disk layout (experimental): LAYOUT=modern keeps the
	     writable state in %ProgramData%\NSClient++, restricted to SYSTEM and
	     administrators, while the program stays in Program Files. LAYOUT=legacy
	     keeps everything in the install folder, which is the default.

	     Deliberately has no default value here. An absent property means "keep
	     whatever this host already uses", read from its boot.ini, so an upgrade
	     neither moves an installation that did not ask to move nor moves a
	     modern one back because the property was not repeated. A fresh install
	     that picked a management server defaults it to modern instead - see
	     ApplyManagement. Secure so it survives a managed or elevated install. -->
	<Property Id="LAYOUT" Secure="yes" />
	<Property Id="ExecPrepareLayout" Hidden="yes" />

	<!-- internal keys (required for the UI, never used) -->
	<Property Id="KEY_NRPEMODE">SECURE</Property>
  
</Include>
