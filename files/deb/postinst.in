#!/bin/sh
set -e


if [ "$1" = "configure" ]; then

    # getent, not `grep -q nsclient /etc/passwd`: that matched any line merely
    # containing the string - an `nsclient-exporter` account, or a home
    # directory or GECOS field mentioning nsclient - and then skipped creating
    # the account the unit runs as entirely.
    if ! getent passwd nsclient >/dev/null 2>&1; then
        adduser --system --no-create-home nsclient
    fi
    if ! getent group nsclient >/dev/null 2>&1; then
        addgroup --system nsclient
    fi
    if ! id -nG nsclient 2>/dev/null | tr ' ' '\n' | grep -qx nsclient; then
        adduser nsclient nsclient
    fi

    # Which group the service account is actually in. Normally "nsclient",
    # created above - but on a host where the account was made by hand, or by a
    # useradd with USERGROUPS_ENAB no, its primary group can be something else,
    # and every chown below has to name a group the daemon is really in or it
    # locks the daemon out of its own files. Empty only when there is no such
    # account at all, which the unit (User=nsclient) could not start under
    # either way.
    svc_group="$(id -gn nsclient 2>/dev/null || true)"
    if id -nG nsclient 2>/dev/null | tr ' ' '\n' | grep -qx nsclient; then
        svc_group=nsclient
    fi

    # Create log + state folders if they don't exist (redundancy check)
    mkdir -p @NSCP_LOGDIR@
    mkdir -p @NSCP_PKGSTATEDIR@
    if [ -n "$svc_group" ]; then
        chown "nsclient:$svc_group" @NSCP_LOGDIR@
        chmod 0750 @NSCP_LOGDIR@
        chown "nsclient:$svc_group" @NSCP_PKGSTATEDIR@
    fi

    # nsclient.ini carries the web admin password, the NRPE/NSCA passwords and
    # the submit-client tokens in plaintext - that is what the file is for, so
    # the filesystem is the boundary around it. Keep it root-owned and writable
    # only by root, readable by the service account through a group, and
    # unreadable by everyone else. Re-applied on upgrade: a host installed
    # before this change still has the old world-readable 0644.
    #
    # The package already ships 0750/0640 root:root, so the group has to be
    # handed over here or the daemon cannot read its own configuration.
    if [ -n "$svc_group" ]; then
        chown "root:$svc_group" @NSCP_PKGSYSCONFDIR@
        chmod 0750 @NSCP_PKGSYSCONFDIR@
        if [ -f @NSCP_PKGSYSCONFDIR@/nsclient.ini ]; then
            chown "root:$svc_group" @NSCP_PKGSYSCONFDIR@/nsclient.ini
            chmod 0640 @NSCP_PKGSYSCONFDIR@/nsclient.ini
        fi
    else
        # No such account: the unit runs as User=nsclient, so the service could
        # not start either way. Relax nothing, say what is wrong.
        echo "NSClient++: no 'nsclient' account; @NSCP_PKGSYSCONFDIR@ is left root-only and the service will not start." >&2
        echo "NSClient++: create the account, then chown root:<its group> and chmod 0640 @NSCP_PKGSYSCONFDIR@/nsclient.ini." >&2
    fi

    # Reload systemd to recognize the new service
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload

        # Enable and start the service (optional, policy dependent)
        systemctl enable nsclient
        systemctl start nsclient

        # On an upgrade the service is already running, so `start` above does
        # nothing and the old binary keeps serving until someone restarts it -
        # meaning an admin who upgraded to pick up a fix does not have it yet.
        # $2 is the previously configured version, i.e. set only on upgrade.
        # (The RPM equivalent has always done this.)
        if [ -n "$2" ]; then
            systemctl try-restart nsclient
        fi
    fi

    # Web UI is shipped as a separate release artifact (Debian/Fedora
    # policy forbids `npm install` at build time), so the .deb installs
    # the daemon without it.
    if [ -z "$2" ]; then
        echo "NSClient++: web UI is not installed. Run 'nscp web install-ui' as root to fetch it."
    fi
fi
