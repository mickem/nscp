#!/bin/sh
set -e

if [ "$1" = "purge" ]; then
    # The state and log directories are systemd's (StateDirectory=,
    # LogsDirectory=); with the DynamicUser drop-in enabled they live below
    # /var/{lib,log}/private with a symlink at the public path, so both
    # spellings are removed here. The runtime directory is on tmpfs and went
    # away with the service.
    rm -rf @NSCP_PURGE_DIRS@

    # The account is declared for systemd-sysusers(8) in
    # @NSCP_SYSUSERSDIR@/nsclient.conf, which has no removal counterpart, so
    # purge removes it here to leave nothing behind. It owned nothing outside
    # the directories removed above. Not reached at all when the DynamicUser
    # drop-in is in use - there is no account to remove in that case.
    if getent passwd nsclient >/dev/null; then
        deluser --system nsclient >/dev/null 2>&1 || userdel nsclient >/dev/null 2>&1 || true
    fi
    if getent group nsclient >/dev/null; then
        delgroup --system nsclient >/dev/null 2>&1 || groupdel nsclient >/dev/null 2>&1 || true
    fi
fi
