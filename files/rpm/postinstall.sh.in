# $1 refers to the number of installed instances (1=install, 2=upgrade)

if [ "$1" -eq 1 ]; then
    # Initial installation

    # The service account is declared in @NSCP_SYSUSERSDIR@/nsclient.conf; the
    # state, log and runtime directories are created and chowned by systemd from
    # the StateDirectory=/LogsDirectory=/RuntimeDirectory= settings in
    # nsclient.service. Neither is done by hand here, which is what lets the
    # DynamicUser drop-in change the identity the service runs under without
    # anything in the package having to agree.
    if command -v systemd-sysusers >/dev/null 2>&1; then
        systemd-sysusers @NSCP_SYSUSERSDIR@/nsclient.conf
    fi

@NSCP_MAINTAINER_DIR_SETUP@
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload
        systemctl enable nsclient
        systemctl start nsclient
    fi
elif [ "$1" -eq 2 ]; then
    # Upgrade
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload
        systemctl try-restart nsclient
    fi
fi
