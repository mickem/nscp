<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SPDX-FileCopyrightText: 2004-2026 Michael Medin
  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-only

  launchd job description for the NSClient++ agent. This is macOS's answer to
  the systemd unit in files/nsclient.service.in, and the two are deliberately
  as close as the platforms allow.

  Generated by CMake: every path here tracks the install prefix, so a build
  configured with -DCMAKE_INSTALL_PREFIX=/opt/nsclient produces a plist that
  points at /opt/nsclient. Do not edit the installed copy - `sudo launchctl
  bootout system/@NSCP_LAUNCHD_LABEL@` first, edit, then bootstrap again, or the
  next upgrade overwrites it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@NSCP_LAUNCHD_LABEL@</string>

    <!--
      `service --run` is the same foreground invocation systemd's ExecStart
      uses: it starts the core and blocks. It must not daemonise - launchd is
      the process's parent and supervises it directly, and a program that forks
      away looks to launchd like one that exited.

      No --pid: the systemd unit writes a PID file because systemd is told to
      read one, whereas launchd already knows the PID of the child it spawned.
      A second, staler opinion about liveness is worth nothing here.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>@NSCP_SBINDIR@/nscp</string>
        <string>service</string>
        <string>--run</string>
        <string>--log-backend</string>
        <string>threaded-file</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@NSCP_PKGLIBDIR@</string>

    <!--
      Unprivileged, as on Linux. A monitoring agent listens on the network and
      runs operator-supplied check scripts, so root is exactly what it should
      not be; the checks that genuinely need privilege are the ones to grant
      individually (via sudoers) rather than the other way round.
    -->
    <key>UserName</key>
    <string>@NSCP_SERVICE_USER@</string>
    <key>GroupName</key>
    <string>@NSCP_SERVICE_USER@</string>

    <!-- Start at boot, and restart if the agent dies. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!--
      Without a throttle launchd respawns a job that fails at startup - a bad
      nsclient.ini, a port already bound - about once a second forever. Ten
      seconds is long enough to keep the machine usable and short enough that a
      transient failure recovers on its own.
    -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!--
      Background: opts the agent out of App Nap and the interactive scheduling
      bands, which is what a long-running daemon wants - and what keeps the 1 Hz
      collectors sampling at 1 Hz on a laptop that is idle or on battery.
    -->
    <key>ProcessType</key>
    <string>Background</string>

    <!--
      The agent's own log is @NSCP_LOGDIR@/nsclient.log, written by the
      threaded-file backend above. These two catch what happens before the
      logger exists or after it has gone: a failure to load a module, a C++
      exception escaping main, a dyld error. Without them that output goes to
      /dev/null and a daemon that will not start says nothing about why.
    -->
    <key>StandardOutPath</key>
    <string>@NSCP_LOGDIR@/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>@NSCP_LOGDIR@/launchd.err.log</string>
</dict>
</plist>
