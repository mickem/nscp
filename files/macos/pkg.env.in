#
# Generated by CMake into <build>/files/macos/pkg.env. Sourced by the packaging
# step in .github/workflows/build-macos.yml so the identifier, the launchd label
# and the install layout have exactly one definition (CMakeLists.txt) rather
# than one in CMake and a second, drifting copy in YAML.
NSCP_PKG_IDENTIFIER="@NSCP_PKG_IDENTIFIER@"
NSCP_LAUNCHD_LABEL="@NSCP_LAUNCHD_LABEL@"
NSCP_SERVICE_USER="@NSCP_SERVICE_USER@"
NSCP_VERSION="@NSCP_FULL_VERSION@"
NSCP_INSTALL_PREFIX="@CMAKE_INSTALL_PREFIX@"
NSCP_SBINDIR="@NSCP_SBINDIR@"
NSCP_BINDIR="@NSCP_BINDIR@"
NSCP_PKGLIBDIR="@NSCP_PKGLIBDIR@"
NSCP_LAUNCHD_DAEMONDIR="@NSCP_LAUNCHD_DAEMONDIR@"
NSCP_PKG_COMPONENT_FILE="@NSCP_PKG_COMPONENT_FILE@"
NSCP_PKG_PRODUCT_FILE="@NSCP_PKG_PRODUCT_FILE@"
