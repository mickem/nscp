<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NSCP.Core: the managed half of the DotnetPlugins module.

    It carries the plugin contract (NSCP.Core.IPlugin & friends), the helper
    classes plugins use to talk to NSClient++ (NSCP.Helpers.*), the protocol
    buffer messages generated from libs/protobuf/*.proto, and the native bridge
    (NSCP.Core.Native.Bridge) that the C++ module calls into through hostfxr.

    Built by CMake (see CMakeLists.txt next to this file) with
      dotnet build NSCP.Core.csproj -c Release -o [build]/modules/dotnet
        -p:NscpProtoDir=[dir with the protoc csharp_out output]
    Plugins reference the produced NSCP.Core.dll and are dropped into the same
    modules/dotnet folder.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NSCP.Core</AssemblyName>
    <RootNamespace>NSCP</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The C++ module hosts this assembly through hostfxr, which needs the
         runtimeconfig.json / deps.json that only "dynamic loading" components
         emit for class libraries. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <!-- Run on whatever .NET runtime the machine has (8, 9, 10, ...) rather
         than insisting on the exact major version we were compiled against. -->
    <RollForward>LatestMajor</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Version Condition="'$(NscpVersion)' != ''">$(NscpVersion)</Version>
    <Company>NSClient++</Company>
    <Product>NSClient++ .NET plugin API</Product>
    <Description>Plugin contract, helpers and native bridge for NSClient++ modules written in .NET</Description>
    <Copyright>2004-2026 Michael Medin</Copyright>
    <PackageLicenseExpression>Apache-2.0 OR GPL-2.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated code (protoc 21.x) needs a runtime at least this new. Newer
         runtimes stay compatible with older generated code. -->
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
  </ItemGroup>

  <!-- The protobuf messages are generated by the CMake build (protoc with
       csharp_out) into $(NscpProtoDir). Pass it with -p:NscpProtoDir=... -->
  <Target Name="NscpRequireProtoDir" BeforeTargets="CoreCompile" Condition="'$(NscpProtoDir)' == ''">
    <Error Text="NscpProtoDir is not set. Build through CMake, or pass -p:NscpProtoDir=[protoc csharp_out directory]." />
  </Target>
  <ItemGroup Condition="'$(NscpProtoDir)' != ''">
    <Compile Include="$(NscpProtoDir)/*.cs" />
  </ItemGroup>

</Project>
