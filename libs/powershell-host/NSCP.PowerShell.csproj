<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NSCP.PowerShell: the managed half of the PowerShellScript module.

    It is an ordinary NSClient++ .NET plugin (NSCP.Core.IPluginFactory) that
    happens to host the PowerShell engine: it reads the scripts configured under
    [/settings/powershell/scripts], gives each one a runspace with an $nscp
    object, and routes the checks, command-line commands and channels the
    scripts register back into them.

    The PowerShell engine is NOT shipped with NSClient++. This project compiles
    against the System.Management.Automation reference assembly and loads the
    real one out of an installed PowerShell 7 at run time (see
    PowerShellRuntime.cs) - the same way a PowerShell binary module does.
    ExcludeAssets="runtime" is what keeps the engine out of the build output.

    Built by CMake (see CMakeLists.txt next to this file) into
    [build]/modules/dotnet, beside NSCP.Core.dll.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NSCP.PowerShell</AssemblyName>
    <RootNamespace>NSCP.PowerShell</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Emits the .deps.json the host uses to resolve private dependencies. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RollForward>LatestMajor</RollForward>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- CMake redirects obj/ and bin/ into the build tree, which turns off the
         SDK's default exclusion of the source-tree obj/ and bin/ folders from the
         *.cs glob; keep excluding them so a stray local `dotnet build` here does
         not feed its generated AssemblyInfo.cs into the CMake build (CS0579). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version Condition="'$(NscpVersion)' != ''">$(NscpVersion)</Version>
    <Company>NSClient++</Company>
    <Product>NSClient++ PowerShell script host</Product>
    <Description>Runs PowerShell scripts inside NSClient++</Description>
    <Copyright>2004-2026 Michael Medin</Copyright>
    <PackageLicenseExpression>Apache-2.0 OR GPL-2.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Compile against the NSCP.Core.dll the build (or an installed agent)
       provides: NscpCoreDir is the folder holding it. Private=false keeps this
       assembly from shipping its own copy next to the shared one. -->
  <PropertyGroup>
    <NscpCoreDir Condition="'$(NscpCoreDir)' == ''">$(MSBuildThisFileDirectory)</NscpCoreDir>
    <GoogleProtobufVersion Condition="'$(GoogleProtobufVersion)' == ''">3.36.1</GoogleProtobufVersion>
    <!-- The PowerShell 7 LTS that still targets net8.0. The engine loaded at
         run time may be any newer 7.x: the resolver in PowerShellRuntime.cs
         binds whatever is in $PSHOME, regardless of its assembly version. -->
    <PowerShellSdkVersion Condition="'$(PowerShellSdkVersion)' == ''">7.4.6</PowerShellSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="NSCP.Core">
      <HintPath>$(NscpCoreDir)/NSCP.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Google.Protobuf" Version="$(GoogleProtobufVersion)" ExcludeAssets="runtime" />
    <!-- compile only: the engine and its native assets come from the installed
         PowerShell 7 at run time, so none of the package's runtime, native or
         build assets may be copied into modules/dotnet. -->
    <PackageReference Include="System.Management.Automation" Version="$(PowerShellSdkVersion)" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

</Project>
