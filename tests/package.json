{
  "name": "nscp-integration-tests",
  "private": true,
  "version": "0.0.0",
  "description": "Cross-platform scenario tests for NSClient++ (replaces tests/<proto>/run-test.bat).",
  "scripts": {
    "test": "jest --runInBand",
    "test:one": "jest --runInBand --testPathPattern",
    "test:no-docker": "NSCP_SKIP_DOCKER=1 jest --runInBand",
    "test:live": "jest --runInBand --config jest.live.config.js",
    "test:stress": "jest --runInBand --config jest.stress.config.js",
    "test:estate": "jest --runInBand --config jest.estate.config.js",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.10",
    "@types/node-forge": "^1.3.11",
    "@types/supertest": "^7.2.1",
    "execa": "^5.1.1",
    "jest": "^30.5.2",
    "node-forge": "^1.4.4",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^10.13.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.6.3",
    "undici": "^7.30.2"
  }
}
